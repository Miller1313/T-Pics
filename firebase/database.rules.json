{
  "rules": {
    ".read": false,
    ".write": false,
    "v2": {
      "config": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('v2/admins').child(auth.uid).val() === true"
      },
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !root.child('v2/admins').exists() && newData.val() === true"
        }
      },
      "users": {
        ".read": "auth != null && root.child('v2/admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "profile": {
            ".write": "auth != null && (auth.uid === $uid || root.child('v2/admins').child(auth.uid).val() === true)"
          },
          "account": {
            ".write": "auth != null && (root.child('v2/admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.child('status').val() === 'active' && newData.child('plan').val() === 'prueba' && root.child('v2/config/trialDays').val() > 0 && newData.child('paidUntil').val() > now && newData.child('paidUntil').val() <= now + root.child('v2/config/trialDays').val() * 86400000 + 600000))"
          },
          "media": {
            ".write": "auth != null && (auth.uid === $uid || root.child('v2/admins').child(auth.uid).val() === true)",
            ".indexOn": [
              "u"
            ]
          },
          "tags": {
            ".write": "auth != null && (auth.uid === $uid || root.child('v2/admins').child(auth.uid).val() === true)"
          },
          "payments": {
            ".write": "auth != null && root.child('v2/admins').child(auth.uid).val() === true"
          }
        }
      }
    },
    "fotos": {
      ".read": "auth != null && root.child('v2/admins').child(auth.uid).val() === true"
    },
    "etiquetas": {
      ".read": "auth != null && root.child('v2/admins').child(auth.uid).val() === true"
    },
    "solicitudes": {
      ".read": "auth != null && root.child('v2/admins').child(auth.uid).val() === true"
    },
    "solicitudes_web": {
      ".read": "auth != null && root.child('v2/admins').child(auth.uid).val() === true"
    }
  }
}